<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>%lld tracks</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld pista</string>
      <key>other</key>
      <string>%lld pistas</string>
    </dict>
  </dict>
  <key>%lld stations</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld emisora</string>
      <key>other</key>
      <string>%lld emisoras</string>
    </dict>
  </dict>
  <key>%lld titles</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld título</string>
      <key>other</key>
      <string>%lld títulos</string>
    </dict>
  </dict>
  <key>%lld tracks marked</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld pista marcada</string>
      <key>other</key>
      <string>%lld pistas marcadas</string>
    </dict>
  </dict>
  <key>%lld tracks. MacAmp watches these folders and picks up new files on its own.</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>%lld pista. MacAmp vigila estas carpetas y detecta archivos nuevos por sí solo.</string>
      <key>other</key>
      <string>%lld pistas. MacAmp vigila estas carpetas y detecta archivos nuevos por sí solo.</string>
    </dict>
  </dict>
  <key>Remove %lld Missing Tracks?</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>¿Quitar %lld pista que falta?</string>
      <key>other</key>
      <string>¿Quitar %lld pistas que faltan?</string>
    </dict>
  </dict>
  <key>Remove %lld Tracks from the Queue?</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>¿Quitar %lld pista de la cola?</string>
      <key>other</key>
      <string>¿Quitar %lld pistas de la cola?</string>
    </dict>
  </dict>
  <key>Remove %lld Tracks?</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>¿Quitar %lld pista?</string>
      <key>other</key>
      <string>¿Quitar %lld pistas?</string>
    </dict>
  </dict>
  <key>Clear %lld Titles?</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>¿Borrar %lld título?</string>
      <key>other</key>
      <string>¿Borrar %lld títulos?</string>
    </dict>
  </dict>
  <key>Remove the %lld tracks whose files were deleted</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>Quita la pista cuyo archivo se borró</string>
      <key>other</key>
      <string>Quita las %lld pistas cuyos archivos se borraron</string>
    </dict>
  </dict>
  <key>● REC %lld files • %@</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>● REC %lld archivo • %@</string>
      <key>other</key>
      <string>● REC %lld archivos • %@</string>
    </dict>
  </dict>
</dict>
</plist>
